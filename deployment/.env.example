# LangChain Platform Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED: LLM Provider API Keys (at least one required)
# =============================================================================
# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (Claude) API Key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# =============================================================================
# REQUIRED FOR TRACING: LangSmith Configuration
# =============================================================================
# Enable LangSmith tracing (set to "true" to enable)
LANGCHAIN_TRACING_V2=true

# LangSmith API key (get from https://smith.langchain.com)
LANGCHAIN_API_KEY=lsv2_your_langsmith_api_key_here

# Project name for grouping traces (separate projects for different apps)
LANGCHAIN_PROJECT=langchain-platform

# LangSmith endpoint (default: https://api.smith.langchain.com)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# OPTIONAL: Web Search Tool (for agents)
# =============================================================================
# Tavily Search API (for web search tools)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# =============================================================================
# OPTIONAL: Azure OpenAI
# =============================================================================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=8000

# =============================================================================
# SECURITY CONFIGURATION (Required for production)
# =============================================================================
# Enable API key authentication (enabled by default for security)
# Set to "false" only for local development without external access
API_KEY_ENABLED=true

# API key for webhook authentication (generate a secure random string)
# REQUIRED when API_KEY_ENABLED=true. Generate with: openssl rand -hex 32
API_KEY=your-secure-api-key-here

# CORS origins (comma-separated, NEVER use "*" in production)
# Add your production domains here
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# =============================================================================
# MICROSOFT TEAMS INTEGRATION
# =============================================================================
# Enable JWT verification for Teams webhooks (enabled by default for security)
TEAMS_JWT_VERIFICATION=true

# Microsoft App ID (from Bot registration in Azure Portal)
TEAMS_APP_ID=your-teams-app-id-here

# Microsoft App Password (from Bot registration)
TEAMS_APP_PASSWORD=your-teams-app-password-here

# =============================================================================
# LANGGRAPH CONFIGURATION
# =============================================================================
# LangGraph Server URL (if running separately)
LANGGRAPH_SERVER_URL=http://localhost:8123

# Default model for LangGraph agents
LANGGRAPH_DEFAULT_MODEL=anthropic

# =============================================================================
# ENTERPRISE AGENTS CONFIGURATION
# =============================================================================

# Default LLM provider for enterprise agents (openai or anthropic)
ENTERPRISE_AGENT_PROVIDER=openai

# Default model for enterprise agents
ENTERPRISE_AGENT_MODEL=gpt-4o-mini

# Vector store persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# =============================================================================
# AGENT MEMORY CONFIGURATION
# =============================================================================
# Memory backend: "postgres", "sqlite", or "memory" (default: memory)
MEMORY_BACKEND=memory

# PostgreSQL connection string (required if MEMORY_BACKEND=postgres)
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://langchain:password@localhost:5432/langchain_agents

# SQLite path (optional, defaults to ./data/checkpoints.db)
# DATABASE_URL=sqlite:///./data/checkpoints.db

# PostgreSQL connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# =============================================================================
# SEMANTIC MEMORY CONFIGURATION
# =============================================================================
# Enable semantic long-term memory (true/false)
SEMANTIC_MEMORY_ENABLED=false

# Embedding model for semantic memory
# Options: "openai" (default) or "huggingface"
EMBEDDING_PROVIDER=openai

# OpenAI embedding model (if using openai provider)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# HuggingFace embedding model (if using huggingface provider)
# Default: sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Semantic memory storage path (for FAISS index persistence)
SEMANTIC_MEMORY_PATH=./data/semantic_memory

# =============================================================================
# CONVERSATION SUMMARIZATION
# =============================================================================
# Number of messages before triggering automatic summarization
CONVERSATION_SUMMARY_THRESHOLD=10

# Maximum tokens before summarization (approximate)
MAX_TOKENS_BEFORE_SUMMARY=4000

# =============================================================================
# AZURE AD / ENTRA ID AUTHENTICATION
# =============================================================================
# Enable Azure AD authentication (true/false)
AUTH_ENABLED=false

# Allow bypass in development mode (true/false)
# When enabled, uses dev user without real authentication
AUTH_BYPASS_DEV=true

# Azure AD tenant ID (from Azure Portal > Azure AD > Overview)
AZURE_TENANT_ID=your-tenant-id

# Azure AD application/client ID (from App Registration)
AZURE_CLIENT_ID=your-client-id

# Azure AD client secret (from App Registration > Certificates & secrets)
AZURE_CLIENT_SECRET=your-client-secret

# OAuth callback URL (must match App Registration redirect URI)
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback

# =============================================================================
# AZURE AD GROUP-TO-ROLE MAPPING (Optional)
# =============================================================================
# Customize Azure AD group names that map to application roles
# Format: GROUP_ROLE_<ROLE>=<Azure AD Group Name>
# Default mappings:
#   LangChain-Admins -> admin
#   LangChain-Operators -> operator
#   LangChain-Users -> user
#   LangChain-Viewers -> viewer

# =============================================================================
# SERVICENOW INTEGRATION
# =============================================================================
# ServiceNow instance name (e.g., "dev12345" for dev12345.service-now.com)
SERVICENOW_INSTANCE=your-instance-name

# ServiceNow API credentials (use a service account with appropriate roles)
SERVICENOW_USERNAME=your-servicenow-username
SERVICENOW_PASSWORD=your-servicenow-password

# Operation mode: "live" for real API calls, "simulation" for mock data
# Default: simulation (safe for development)
SERVICENOW_MODE=simulation

# Request timeout in seconds (default: 30)
SERVICENOW_TIMEOUT=30

# SSL verification (set to "false" for dev instances with self-signed certs)
SERVICENOW_VERIFY_SSL=true

# =============================================================================
# DOCUMENT INTELLIGENCE AGENT
# =============================================================================
# Allowed domains for web search (comma-separated)
# Example: docs.python.org,stackoverflow.com,github.com,docs.langchain.com
ALLOWED_SEARCH_DOMAINS=

# Tesseract OCR executable path (Windows only, optional)
# If not set, pytesseract will look for tesseract in PATH
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Document chunking settings (optional)
DOC_CHUNK_SIZE=1000
DOC_CHUNK_OVERLAP=200

# Default target language for translations (optional)
DEFAULT_TARGET_LANGUAGE=en
